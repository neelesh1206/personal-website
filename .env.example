# Database (Neon)
DATABASE_URL=""

# Resend
RESEND_API_KEY=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Your email (for new contact notifications)
CONTACT_NOTIFICATION_EMAIL=""

# Strava API (one-time OAuth — see PLAN.md for setup steps)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REFRESH_TOKEN=""

# Resend "from" address (must be a verified sending domain)
RESEND_FROM_ADDRESS="Neelesh <hello@neeleshkakaraparthi.dev>"

# Public link to your resume PDF (used in the visitor email)
# Default is the file at public/resume.pdf served from the site root.
PUBLIC_RESUME_URL="https://neeleshkakaraparthi.dev/resume.pdf"

# /admin password (12+ chars). Set a strong value in Vercel.
ADMIN_PASSWORD=""

# Salt for the page-view visitor hash. Any 32+ char random string; only
# matters that it stays stable per env so the daily-hash window doesn't
# accidentally rotate mid-day.
ANALYTICS_SALT=""

# Where the daily coding-prep summary email is sent (must be set for the
# /api/cron/prep-daily-summary cron to email; Slack is independent).
ADMIN_EMAIL=""

# Optional override for the Resend "from" address used by the daily
# prep summary. Falls back to onboarding@resend.dev if unset.
RESEND_FROM=""

# Slack incoming webhook URL for the daily prep summary. Optional —
# missing var no-ops the Slack post.
SLACK_WEBHOOK_URL=""

# Vercel Cron Bearer token for /api/cron/prep-daily-summary. Vercel sets
# the matching Authorization header automatically when configured.
CRON_SECRET=""

# HuggingFace Inference API key for the daily prep summary's AI narrative.
# Same key as the MarketMind pipeline — `hf_...`. Optional; cron falls back
# to a templated rollup when unset.
HUGGINGFACE_API_KEY=""

# Optional override of the summary model. Defaults to
# mistralai/Mistral-Nemo-Instruct-2407 (matches MarketMind).
HUGGINGFACE_SUMMARY_MODEL=""

# Optional provider routing override (auto | hf-inference | together |
# fireworks-ai | nebius). Default `auto` works for HF Pro users.
HUGGINGFACE_PROVIDER=""
